---
import Icon from './Icon.astro';
import { profile } from '@data/portfolio';
---

<header class="site-header">
  <a class="brand" href="#top" aria-label="Kishen Sharma home">
    <span class="brand-mark">KS</span>
    <span>{profile.name}</span>
  </a>
  <nav aria-label="Primary navigation">
    <a href="#work">Work</a>
    <a href="#experience">Experience</a>
    <a href="#skills">Stack</a>
    <a href={profile.resumeHref}>Resume</a>
  </nav>
  <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme">
    <Icon name="spark" />
  </button>
</header>
